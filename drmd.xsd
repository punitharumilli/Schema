<?xml version="1.0" encoding="UTF-8"?>
<!-- Temporary namespace URN used because no official project domain is assigned yet. -->
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:drmd="urn:drmd:schema"
    xmlns:dcc="https://ptb.de/dcc"
    xmlns:si="https://ptb.de/si"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
    targetNamespace="urn:drmd:schema"
    elementFormDefault="qualified"

    version="1.0.0">

  <xs:import namespace="https://ptb.de/dcc"
           schemaLocation="supporting/dcc.xsd"/>
  <xs:import namespace="https://ptb.de/si"
           schemaLocation="supporting/SI_Format.xsd"/>
  <xs:import namespace="http://www.w3.org/2000/09/xmldsig#"
           schemaLocation="supporting/xmldsig-core-schema.xsd"/>

  <!-- ========================================================= -->
  <!--  Simple Types (global for reuse & validation)             -->
  <!-- ========================================================= -->

  <!-- Semantic version: major.minor.patch -->
  <xs:simpleType name="schemaVersionType">
    <xs:annotation>
      <xs:documentation>
        Specifies the semantic version string (major.minor.patch) of the DRMD schema specification
        that the instance document follows (e.g., "1.0.0").
        Major version updates signify breaking structural changes that require parsers to be migrated.
        Minor version updates indicate backward-compatible additions of optional elements or identifier schemes.
        Patch versions address non-structural schema documentation corrections or minor text clarifications.
        Because patch updates never change the content model, consumers MUST accept any patch level
        within a supported major.minor line: a document declaring "1.0.0" and a document declaring
        "1.0.1" would be structurally identical and both validate against this schema.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="\d+\.\d+\.\d+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Title of the DRMD document -->
  <xs:simpleType name="titleOfDocumentType">
    <xs:annotation>
      <xs:documentation>
        The type of the document. It decides which requirements of ISO 33401:2024, Table 1 apply.
        - referenceMaterialCertificate: the document is an RM certificate for a Certified Reference Material (CRM) per ISO 33401:2024. The document MUST contain at least one property value with an associated measurement uncertainty and a metrological traceability statement. Software can rely on values marked as certified carrying both.
        - productInformationSheet: the document is a product information sheet for a Reference Material (RM) per ISO 33401:2024. Property values are valid measurement results but are not required to include measurement uncertainty or metrological traceability. The distinction from a certificate is solely that no value is certified with uncertainty and traceability.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="productInformationSheet"/>
      <xs:enumeration value="referenceMaterialCertificate"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ========================================================= -->
  <!-- Identifier building blocks                                -->
  <!-- ========================================================= -->

  <xs:complexType name="identifierType">
    <xs:annotation>
      <xs:documentation>
        A general-purpose identifier: the scheme it belongs to (for example DOI, CAS or ROR), the
        identifier value itself, and an optional link where it can be looked up. The @id, @refId and
        @refType attributes allow other parts of the document to refer to it.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="scheme" type="dcc:notEmptyStringType">
        <xs:annotation>
          <xs:documentation>
            The naming system, registry or authority the identifier comes from (e.g., 'DOI', 'CAS', 'ROR').
            It tells software how to interpret and look up the value.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="value" type="dcc:notEmptyStringType">
        <xs:annotation>
          <xs:documentation>
            The identifier exactly as issued within the scheme (e.g., '10.1000/182' or '7440-50-8').
            Give only the identifier here, without descriptive text, so that it can be searched and matched.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="link" type="xs:anyURI" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            An optional, persistent URL (preferably HTTPS) where the identifier can be looked up or verified.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>

    <xs:attribute name="id" type="xs:ID" use="optional"/>
    <xs:attribute name="refId" type="xs:IDREFS" use="optional"/>
    <xs:attribute name="refType" type="drmd:refTypesType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="organizationIdentifierListType">
    <xs:annotation>
      <xs:documentation>
        A list of identifiers for the reference material producer as an organisation (e.g., ROR, LEI
        or a national company register number). They identify the producer unambiguously, even where
        its name is written in different ways.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="organizationIdentifier" type="drmd:identifierType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="materialIdentifierListType">
    <xs:annotation>
      <xs:documentation>
        A list of identifiers for the material, such as product or catalogue number and batch or lot
        number. They link this document to the labelling on the physical unit.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="materialIdentifier" type="drmd:identifierType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="propertyIdentifierListType">
    <xs:annotation>
      <xs:documentation>
        A list of identifiers for a measured property or analyte, taken from a recognised nomenclature
        (such as a CAS number or an IUPAC name). They let software match results across documents
        without relying on local, non-unique labels.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="propertyIdentifier" type="drmd:identifierType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="documentIdentifierListType">
    <xs:annotation>
      <xs:documentation>
        A list of further identifiers for this document, such as a DOI, an internal reference or an
        ERP number, used to link the document to other systems.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="documentIdentifier" type="drmd:identifierType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="refTypesType">
    <xs:annotation>
      <xs:documentation>
        Controlled list of values for the @refType attribute, which states what kind of information
        an element holds, so that software interprets cross-references in the same way.
        - basic_certificateIdentification: the element identifies the document.
        - basic_measuredValue: the element is a measured value (a quantity).
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="basic_certificateIdentification"/>
      <xs:enumeration value="basic_measuredValue"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="quantityType">
    <xs:annotation>
      <xs:documentation>
        A quantity (value, unit and, where given, uncertainty) based on dcc:primitiveQuantityType,
        extended so that each quantity can carry its own property identifiers. This keeps a value and
        the identity of what was measured together, which matters most in tables with many analytes.

        UNITS AND QUANTITY KINDS
        The value is one of the choices offered by dcc:primitiveQuantityType: si:real, si:hybrid,
        si:complex, si:constant, si:realListXMLList, si:complexListXMLList, dcc:charsXMLList or dcc:noQuantity.
          - SI and SI-compatible units are written as D-SI unit strings in si:unit (for example \gram,
            \milli\gram\kilogram\tothe{-1}).
          - A unit that D-SI cannot express is reported with si:hybrid: at least one si:real inside the hybrid
            carries the value in a machine-readable SI unit, and a sibling si:real carries the same value in the
            non-SI unit. The SI-encoded sibling is what keeps the value computable; the non-SI sibling preserves
            the form the field expects. Where the non-SI unit itself needs defining, dcc:nonSIUnit and
            dcc:nonSIDefinition inside properties/measurementMetaData carry that definition.
          - The KIND of quantity (for example MassFraction, Density, AmountOfSubstanceConcentration) is stated
            separately from the unit with si:quantityTypeQUDT, which D-SI types against the QUDT quantity-kind
            vocabulary. It is available inside si:real and the list variants, and is recommended for every
            certified value: it tells a consumer what was measured, which a unit alone does not.
        A QUDT quantity kind is not a substitute for a unit and never replaces si:unit.
      </xs:documentation>
    </xs:annotation>
    <xs:complexContent>
      <xs:extension base="dcc:primitiveQuantityType">
        <xs:sequence>
          <xs:element name="propertyIdentifiers" type="drmd:propertyIdentifierListType" minOccurs="0">
            <xs:annotation>
              <xs:documentation>
                Identifiers of the property this value belongs to (for example the CAS number of an
                analyte), so that values in a composition table can be matched unambiguously by software.
              </xs:documentation>
            </xs:annotation>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:annotation>
    <xs:documentation>
      DRMD: Digital Reference Material Document
      Copyright (c) 2024 Bundesanstalt für Materialforschung und -prüfung (BAM)

      This XML Schema Definition (XSD) is free software: you can redistribute
      it and/or modify it under the terms of the GNU Lesser General Public License
      as published by the Free Software Foundation, version 3 of the License.
      This XSD is distributed in the hope that it will be useful, but WITHOUT ANY
      WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
      FOR A PARTICULAR PURPOSE. See the GNU Lesser General Public License for
      more details. The development of the Digital Reference Material Document (DRMD)
      is partially funded and supported by the QI-Digital project.
    </xs:documentation>
    <xs:documentation>
      DUAL-PROFILE ARCHITECTURE
      This schema supports two document profiles governed by the titleOfTheDocument element:
        - referenceMaterialCertificate (CRM): Certified Reference Material documents per ISO 33401:2024.
        - productInformationSheet (RM): Reference Material documents per ISO 33401:2024.

      Both profiles share an identical XML structure. The minOccurs constraints in this XSD
      are set to the most permissive level (accommodating the productInformationSheet profile).
      Profile-specific mandatory requirements (e.g., metrological traceability for CRM,
      uncertainty assignment for certified values, material description for CRM,
      approving officer/responsible persons for CRM) are enforced by the companion Schematron
      validation file: drmd-business-rules.sch

      IMPORTANT: Full validation requires running BOTH this XSD schema AND
      the companion Schematron rules. The XSD alone cannot check the profile-specific
      requirements of ISO 33401:2024, Table 1.
    </xs:documentation>
    <xs:documentation>
      DOCUMENT COMPONENTS (ISO 33401:2024, Section 5.2.12)
      ISO 33401:2024 requires that an RM document be arranged so that all its components are
      recognisable as part of the whole document and that the end of the document is clearly
      marked. In a DRMD instance this requirement is met by the XML document itself rather than
      by a dedicated element:
        - a DRMD instance is a single well-formed XML document with exactly one
          drmd:digitalReferenceMaterialDocument root element, so its start and end are explicit
          and every component is, by construction, inside the whole;
        - the mandatory @schemaVersion attribute states which specification the components
          follow, and coreData/documentVersion states which revision of the content they belong to;
        - coreData/uniqueIdentifier binds every component to one document instance.
      Producers who additionally publish a human-readable rendition SHOULD embed it in a
      root-level drmd:document element (or reference it from
      statements/referenceToCertificationReport) so that the machine-readable and human-readable
      components travel together and cannot be separated in handling.
      No Schematron rule is defined for Section 5.2.12: the requirement is satisfied structurally,
      and an assertion that always holds would only add noise to validation reports.
    </xs:documentation>
    <xs:documentation>
      EXTERNAL SCHEMAS USED BY THIS SPECIFICATION
        - DCC (Digital Calibration Certificate, PTB, https://ptb.de/dcc) supplies the shared
          building blocks: multilingual text (dcc:textType), rich content with attachments and
          formulas (dcc:richContentType), contacts and responsible persons, embedded binary data
          (dcc:byteDataType), used methods, measurement metadata, and the quantity container
          (dcc:primitiveQuantityType) that drmd:quantityType extends.
        - D-SI (Digital System of Units, PTB, https://ptb.de/si) supplies every numeric value,
          unit and measurement uncertainty (si:real, si:realListXMLList, si:hybrid, si:complex,
          si:constant and their uncertainty structures).
        - QUDT (http://qudt.org/vocab/) is reached through D-SI, not imported directly: D-SI
          declares si:quantityTypeQUDT (and its list variants) with type qudt:quantitykind, so a
          QUDT quantity kind may be stated inside any D-SI quantity in a DRMD document.
        - XML Signature Syntax and Processing (W3C, http://www.w3.org/2000/09/xmldsig#) supplies
          the ds:Signature element used at the document root.
      Each of these is vendored under supporting/ and resolved offline through catalog.xml.
    </xs:documentation>
  </xs:annotation>

  <!-- Root element -->
  <xs:element name="digitalReferenceMaterialDocument" type="drmd:digitalReferenceMaterialDocumentType"/>

  <!-- Root type -->
  <xs:complexType name="digitalReferenceMaterialDocumentType">
    <xs:annotation>
      <xs:documentation>
        The root of a DRMD. It serves both document types, the RM certificate (for a CRM) and the
        product information sheet (for an RM), and holds administrative data, materials, property
        values and statements, followed by an optional comment, optional embedded documents and
        optional digital signatures. The document type is set by coreData/titleOfTheDocument; the
        requirements that differ between the two types (ISO 33401:2024, Table 1) are checked by the
        companion Schematron rules (drmd-business-rules.sch).
      </xs:documentation>
    </xs:annotation>

    <xs:sequence>
      <xs:element name="administrativeData" type="drmd:administrativeDataType">
        <xs:annotation>
          <xs:documentation>
            Administrative information: data about the document itself, the reference material
            producer, and the persons responsible for the document.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="materials" type="drmd:materialListType">
        <xs:annotation>
          <xs:documentation>
            The reference material(s) covered by this document, with their names, identifiers (for
            example product code and batch number) and, where applicable, minimum sample size.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="propertiesList" type="drmd:propertiesListType">
        <xs:annotation>
          <xs:documentation>
            The property values of the material, with units and uncertainties, grouped into blocks.
            Each block states with its @isCertified attribute whether its values are certified or
            informative.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="statements" type="drmd:statementListType">
        <xs:annotation>
          <xs:documentation>
            The ordered sequence of auxiliary, narrative operational notes for handling and use of the
            material, including storage information and pre-treatment directives.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="comment" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            An optional plain-text comment on the document as a whole, for example internal or
            processing notes. It is not part of the content required by ISO 33401:2024 and cannot be
            given in several languages.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="document" type="dcc:byteDataType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            An optional, repeatable slot for embedding a Base64-encoded file, typically an exact PDF
            rendition of the official RM document. This supports long-term archiving, because a single
            XML file then holds both the machine-readable data and the human-readable document (see the
            "Archival Package" interoperability profile in the DRMD guidance document).
            Can also be used for embedding documents other than the RM document, or for multiple
            documents. Give each embedded document a name or description that says what it is, so that
            the rendition of the RM document can be told apart from any other file.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element ref="ds:Signature" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            An optional, repeatable XML digital signature (XMLDSig) that lets a recipient check that the
            document has not been changed since it was signed, and who signed it.
            Note: the imported schema is the complete W3C XML Signature schema, so XSD validation does check
            the structure of the signature (SignedInfo and SignatureValue present, KeyInfo and Object optional,
            algorithm attributes present). What XSD validation cannot do is verify the cryptography: recomputing
            digests, checking the signature value, and validating the certificate chain and its revocation status
            require a dedicated XMLDSig library. A structurally valid ds:Signature is therefore never, on its own,
            evidence that the document is authentic.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>

    <xs:attribute name="schemaVersion" type="drmd:schemaVersionType" use="required"/>
  </xs:complexType>

  <!-- administrativeData -->
  <xs:complexType name="administrativeDataType">
    <xs:annotation>
      <xs:documentation>
        Administrative information, in this order: core data about the document, the reference
        material producer, and the responsible persons.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="coreData" type="drmd:coreDataType"/>
      <xs:element name="referenceMaterialProducer" type="drmd:referenceMaterialProducerType"/>
      <xs:element name="respPersons" type="dcc:respPersonListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            The persons responsible for the document, including the approving officer, each with their
            role or function (e.g., 'Head of Department', 'Quality Manager') and contact details.
            dcc:mainSigner can mark the person who signs the document.
            PROFILE NOTE (ISO 33401:2024, Section 5.3.5): This element is structurally optional in the XSD.
            For referenceMaterialCertificate documents, the name AND FUNCTION of the RM producer's
            approving officer is MANDATORY. Two Schematron rules enforce this together: RMC-010 requires the
            respPersons list to be present, and RMC-012 requires at least one dcc:respPerson in it to state a
            dcc:role, because ISO 33401:2024 asks for the officer's function and not only their name. The
            function may be the name of the responsible organisational unit rather than a personal job title.
            For productInformationSheet documents, this element is optional.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="coreDataType">
    <xs:annotation>
      <xs:documentation>
        Core data about the document: its type (RM certificate or product information sheet), its
        unique identifier, its version, optional further identifiers, and its period of validity.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="titleOfTheDocument" type="drmd:titleOfDocumentType"/>

      <xs:element name="uniqueIdentifier" type="dcc:notEmptyStringType">
        <xs:annotation>
          <xs:documentation>
            A mandatory identifier of this DOCUMENT that is unique worldwide (a UUID is recommended).
            If the content is changed after issue, a new document with a new unique identifier is
            issued; the existing document is not edited.
            SCOPE NOTE (ISO 33401:2024, Section 5.2.3): this element identifies the document, not the reference
            material. The unique identifier OF THE RM required by Section 5.2.3, typically a product code combined
            with a batch or lot number such as "NMIJ CRM 7305-a" or "ERM-AC110", is carried by
            materials/material/materialIdentifiers and is enforced by Schematron rule DRMD-016. Do not use this
            element for the RM identifier: one document may cover several materials, and the same material is
            described by successive document revisions.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="documentVersion" type="dcc:notEmptyStringType">
        <xs:annotation>
          <xs:documentation>
            A mandatory version string identifying the revision of this document.
            Enables tracking of document updates and ensures recipients can verify
            they hold the current version (ISO 33401:2024, Section 5.2.13, Mandatory for both
            document profiles). Its presence is required by this XSD and is additionally asserted
            by the companion Schematron rule DRMD-011, so that a Schematron-only validation report
            also covers the requirement.
            A version number, an approval date, or both are acceptable; whichever form is chosen
            must change whenever the document content changes.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="documentIdentifiers" type="drmd:documentIdentifierListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional further identifiers of this document, such as a DOI or an internal order or ERP
            number, for linking it to other systems.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="validity" type="drmd:ValidityType" minOccurs="1"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ValidityType">
    <xs:annotation>
      <xs:documentation>
        The period of validity of the document (ISO 33401:2024, Section 5.2.8), given in one of three
        ways: valid until revoked, valid for a period after dispatch, or valid until a fixed date.
        Software can compare it with the current date, for example to warn before an expired material
        is used.
      </xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="untilRevoked" type="xs:boolean" fixed="true">
        <xs:annotation>
          <xs:documentation>
            The document stays valid until the producer withdraws or replaces it. Suitable for
            materials whose property values are not expected to change over time.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="timeAfterDispatch">
        <xs:annotation>
          <xs:documentation>
            Validity counted from the date a unit is dispatched. Software can add the period to the
            dispatch date to obtain the end of validity for an individual unit.
          </xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:sequence>
            <xs:element name="dispatchDate" type="xs:date" minOccurs="0">
              <xs:annotation>
                <xs:documentation>
                  The optional date on which the unit was dispatched. Where a document is issued and
                  signed for each shipment, this date may coincide with the time stamp of the signature.
                </xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element name="period" type="xs:duration" minOccurs="1">
              <xs:annotation>
                <xs:documentation>
                  A mandatory ISO 8601 duration format string (e.g., 'P3Y2M') stating the exact lifespan
                  allotted for material use once dispatched.
                </xs:documentation>
              </xs:annotation>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

      <xs:element name="specificTime" type="xs:date">
        <xs:annotation>
          <xs:documentation>
            A fixed end date of validity (YYYY-MM-DD). After this date the producer no longer
            guarantees the stated property values.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="materialClassType">
    <xs:annotation>
      <xs:documentation>
        A repeatable classification element used to tie the reference material to an industry standard,
        matrix classification taxonomy, or public cataloging scheme.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="reference" type="dcc:notEmptyStringType">
        <xs:annotation>
          <xs:documentation>
            The classification standard, taxonomy or scheme being used (e.g., 'ISO 12103-1', 'UNS').
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="classID" type="dcc:notEmptyStringType">
        <xs:annotation>
          <xs:documentation>
            The class code or name within that scheme (e.g., 'A2 Fine Test Dust').
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="link" type="xs:anyURI" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            An optional URL where the classification scheme or the class definition can be found.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>

    <xs:attribute name="id" type="xs:ID" use="optional"/>
    <xs:attribute name="refId" type="xs:IDREFS" use="optional"/>
    <xs:attribute name="refType" type="drmd:refTypesType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="identificationListType">
    <xs:annotation>
      <xs:documentation>
        A list of further identifications, such as inventory numbers or customer reference numbers.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="identification" type="drmd:identificationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="identificationType">
    <xs:annotation>
      <xs:documentation>
        A further identification: who assigned it, its value, and an optional name saying what kind of
        identification it is.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="issuer">
        <xs:annotation>
          <xs:documentation>
            Who assigned the value: the reference material producer, the customer, the owner, or another party.
          </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="referenceMaterialProducer"/>
            <xs:enumeration value="customer"/>
            <xs:enumeration value="owner"/>
            <xs:enumeration value="other"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>

      <xs:element name="value" type="dcc:notEmptyStringType">
        <xs:annotation>
          <xs:documentation>
            The identification value as assigned by the issuer.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="name" type="dcc:textType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            An optional name, in one or more languages, saying what kind of identification this is,
            for example 'Inventory number' or 'Customer order number'.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>

    <xs:attribute name="id" type="xs:ID" use="optional"/>
    <xs:attribute name="refType" type="drmd:refTypesType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="referenceMaterialProducerType">
    <xs:annotation>
      <xs:documentation>
        The reference material producer: the organisation responsible for the reference material and
        for this document (ISO 33401:2024, Section 5.2.5). Holds its name, contact details, optional
        statements on electronic seals, signatures and time stamps, and optional organisation
        identifiers such as ROR.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="dcc:textType">
        <xs:annotation>
          <xs:documentation>
            The official name of the producer. It may be given in several languages, each marked with
            its ISO 639-1 language code (e.g., 'en', 'de').
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="contact" type="dcc:contactType">
        <xs:annotation>
          <xs:documentation>
            The producer's contact details: name, and optionally e-mail, phone, fax and web link, plus
            the postal address in dcc:location.
            ADDRESS CARDINALITY: dcc:location (dcc:locationType) is a repeatable choice. Each of its
            elements (city, countryCode, postCode, postOfficeBox, state, street, streetNo, further,
            positionCoordinates) is optional and may be repeated, in any order; only at least one of
            them must be present. Typically city, postCode, street, streetNo and countryCode are given;
            postOfficeBox, state and positionCoordinates are added only where they apply.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="cryptElectronicSeal" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional. States whether the producer applies an electronic seal (a signature of the
            organisation rather than of a person) to its documents.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="cryptElectronicSignature" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional. States whether personal electronic signatures of the responsible persons are applied.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="cryptElectronicTimeStamp" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional. States whether a trusted time stamp is applied, so that signatures can still be
            checked after the signing certificate has expired.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="organizationIdentifiers" type="drmd:organizationIdentifierListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional persistent identifiers of the producer (e.g., ROR, LEI), so that software can
            identify it unambiguously.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- materialListType -->
  <xs:complexType name="materialListType">
    <xs:annotation>
      <xs:documentation>
        The list of reference materials covered by this document. At least one material is required;
        several can be listed, for example for a set of materials supplied together.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="material" type="drmd:materialType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- materialType -->
  <xs:complexType name="materialType">
    <xs:annotation>
      <xs:documentation>
        One reference material: its name, an optional description, optional classifications, the
        minimum sample size and item quantities where applicable, and its identifiers (for example
        product code and batch number).
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="dcc:textType">
        <xs:annotation>
          <xs:documentation>
            The name of the reference material (ISO 33401:2024, Section 5.2.4), as it appears on the
            label. It may be given in several languages.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="description" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            A description of the material, for example its matrix, form, appearance, dimensions and
            packaging. Text can be accompanied by files such as drawings or photographs.
            PROFILE NOTE (ISO 33401:2024, §5.3.2): This element is structurally optional in the XSD.
            For referenceMaterialCertificate documents, the description of the material is MANDATORY
            and its presence is enforced by the companion Schematron rules.
            For productInformationSheet documents, this element is recommended but not required.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="materialClass" type="drmd:materialClassType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            Optional, repeatable classification of the material according to a standard or another
            classification scheme.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="minimumSampleSize" type="dcc:itemQuantityListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            The smallest amount of material (mass, volume, area, ...) for which the stated property
            values and uncertainties apply, usually derived from the homogeneity study. Software can
            use it to warn when a smaller test portion is used.
            PROFILE NOTE (ISO 33401:2024, §5.2.7): This element is 'mandatory whenever applicable' for both
            document profiles. It is structurally optional in the XSD to accommodate materials where a
            minimum sample size is not applicable. Its presence is enforced by the companion Schematron
            rule DRMD-008 (conditional-error).
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="itemQuantities" type="dcc:itemQuantityListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional quantities describing the unit as supplied, for example the nominal mass or volume
            per unit, or the number of items per package.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="materialIdentifiers" type="drmd:materialIdentifierListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            The identifiers of the reference material, for example product code and batch or lot number,
            used to match the document to the physical unit and to database records.
            PROFILE NOTE (ISO 33401:2024, Section 5.2.3): this element carries the unique identifier OF THE RM,
            which is MANDATORY for both document profiles. The element is structurally optional in the XSD only to
            keep the two profiles on one content model; its presence is enforced by the companion Schematron rule
            DRMD-016 (error). Provide at least one identifier that distinguishes this RM from any other RM issued
            by the same producer, normally a product code and, where units are produced in batches, a batch or lot
            number as a second identifier. Where each unit is individually characterised, add the unit serial number
            as a further identifier. Keep the values exactly as they are printed on the container label, so that the
            physical unit and the document can be matched without interpretation.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="statementListType">
    <xs:annotation>
      <xs:documentation>
        A structurally ordered container managing auxiliary, narrative operational notes for handling
        and use of the material.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="intendedUse" type="dcc:richContentType" minOccurs="1">
        <xs:annotation>
          <xs:documentation>
            A mandatory metrological disclosure defining the explicitly intended application scope and target
            analytical techniques (e.g., spark-OES calibration). Where relevant, it also states uses for which
            the material is not suitable, to help prevent misapplication.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="commutability" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            A statement on commutability: how closely the reference material behaves like routine samples
            when measured with different measurement procedures. Particularly relevant for clinical and
            biological materials.
            PROFILE NOTE (ISO 33401:2024, §5.2.9): This element is 'mandatory whenever applicable' for both
            document profiles. It is structurally optional in the XSD to accommodate materials where
            commutability is not applicable. Its presence is enforced by the companion Schematron
            rule DRMD-013 (conditional-error).
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="storageInformation" type="dcc:richContentType" minOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Mandatory storage conditions (e.g., temperature, protection from light or moisture, inert gas)
            needed to keep the material stable and its property values valid.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="instructionsForHandlingAndUse" type="dcc:richContentType" minOccurs="1">
        <xs:annotation>
          <xs:documentation>
            Mandatory preparation instructions detailing e.g., cleaning cycles, physical polishing constraints,
            and drying workflows required of operators before executing analytical calibrations.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="metrologicalTraceability" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            A narrative statement formalizing the chain of comparisons linking certified results back to the
            SI base units or international calibration benchmarks, supporting laboratory audit trails.
            PROFILE NOTE (ISO 33401:2024, §5.3.4): This element is structurally optional in the XSD to accommodate
            productInformationSheet documents where metrological traceability is not required. For
            referenceMaterialCertificate documents, this element is MANDATORY and its presence is enforced
            by the companion Schematron rules (rule RMC-001).
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="healthAndSafetyInformation" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional health and safety information, for example the hazards of the material and the
            protective measures to take. A safety data sheet (SDS) can be attached as a file.
            PROFILE NOTE (ISO 33401:2024, §5.4.3): This element is 'recommended' for both document profiles.
            Its presence is encouraged by the companion Schematron rule DRMD-015 (warning).
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="subcontractors" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            An optional transparency record mapping contributions from subcontracted partner laboratories,
            mainly used in interlaboratory studies.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="legalNotice" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional legal notices, for example disclaimers, limitations of liability or the applicable jurisdiction.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="referenceToCertificationReport" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            An optional reference to the certification report, or to another report describing the
            characterisation, homogeneity and stability studies, given as a citation, a link or an
            attached file (ISO 33401:2024, §5.4.7, Optional for both document profiles).
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="statement" type="dcc:richContentType" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            A repeatable, generic catch-all narrative element designed to capture auxiliary operational notes
            for handling and use of the material that lack a dedicated element field.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="propertiesListType">
    <xs:annotation>
      <xs:documentation>
        The property values, grouped into one or more properties blocks. Each block states with
        @isCertified whether its values are certified, so that software can tell certified values
        from informative ones.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="properties" type="drmd:propertiesType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="resultListType">
    <xs:annotation>
      <xs:documentation>
        The results within a properties block. Each result is typically one table or one value.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="result" type="drmd:resultType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="resultType">
    <xs:annotation>
      <xs:documentation>
        One result: a name, an optional description, and the data. Unlike dcc:resultType, the data
        always uses the DRMD quantity type, so that every value can carry property identifiers.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="dcc:textType"/>
      <xs:element name="description" type="dcc:richContentType" minOccurs="0"/>
      <xs:element name="data" type="drmd:dataType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="optional"/>
    <xs:attribute name="refId" type="xs:IDREFS" use="optional"/>
    <xs:attribute name="refType" type="drmd:refTypesType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="dataType">
    <xs:annotation>
      <xs:documentation>
        The data of a result: either a list of quantities (for example a composition table) or a
        single quantity.
      </xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="list" type="drmd:listType"/>
      <xs:element name="quantity" type="drmd:quantityType"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="listType">
    <xs:annotation>
      <xs:documentation>
        A list of quantities, for example one row per analyte in a composition table. Each quantity
        carries its own value, unit, uncertainty and identifiers.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="quantity" type="drmd:quantityType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="propertiesType">
    <xs:annotation>
      <xs:documentation>
        A block of property values: its name, an optional description, the measurement procedures,
        the results and optional metadata. The @isCertified attribute states whether the values in
        this block are certified ("true") or informative (attribute omitted or "false").
        PROFILE NOTE (ISO 33401:2024, §5.3.3):
        - referenceMaterialCertificate: MUST contain at least one properties block with @isCertified="true".
          Certified property values MUST include measurement uncertainty and metrological traceability
          (Schematron rules RMC-002, RMC-003).
        - productInformationSheet: MUST NOT set @isCertified="true" on any properties block.
          Uncertainty values are optional (Schematron rule PIS-001).
      </xs:documentation>
    </xs:annotation>

    <xs:sequence>
      <xs:element name="name" type="dcc:textType">
        <xs:annotation>
          <xs:documentation>
            The title of the block (e.g., 'Certified values', 'Indicative values', 'Additional information').
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="description" type="dcc:richContentType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Information that applies to all values in the block, for example 'The uncertainty is the
            expanded uncertainty with a coverage factor k = 2'.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="procedures" type="dcc:usedMethodListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            The measurement procedures, with details such as methods, instruments and referenced
            standards (e.g., ISO 11885), to enable procedural replication.
            NOTE: This element covers both applied measurement procedures (methods used to establish
            the property values) and intended measurement procedures (methods for which the material
            is suited). Producers are encouraged to clearly distinguish between these in the method
            descriptions. ISO 33401:2024, §5.2.14 makes procedures for operationally defined measurands
            'mandatory whenever applicable'; §5.4.2 makes procedures for non-operationally defined
            measurands 'recommended' for both document profiles. Taken together, the overall requirement
            is 'mandatory whenever applicable'. The companion Schematron rule DRMD-014 (conditional-error)
            enforces the presence of procedures; RMC-005 (warning) provides an additional advisory
            for certified property blocks.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="results" type="drmd:resultListType">
        <xs:annotation>
          <xs:documentation>
            The results (values) of this block. Mandatory.
          </xs:documentation>
        </xs:annotation>
      </xs:element>

      <xs:element name="measurementMetaData" type="dcc:measurementMetaDataListType" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Optional metadata arrays containing further details pertaining to the measurement data.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>

    <xs:attribute name="id" type="xs:ID" use="optional"/>
    <xs:attribute name="refId" type="xs:IDREFS" use="optional"/>
    <xs:attribute name="refType" type="drmd:refTypesType" use="optional"/>

    <xs:attribute name="isCertified" type="xs:boolean" use="optional">
      <xs:annotation>
        <xs:documentation>
          States whether the values in this block are certified. "true" marks certified values.
          Omitted or "false" means the values are informative (not certified), for example indicative
          or additional values.
          INDICATIVE VALUES (ISO 33401:2024, Section 5.4.5, Optional for both document profiles): indicative
          values are carried in an ordinary properties block with isCertified omitted or set to 'false'.
          No separate element and no Schematron rule exist for them, because the requirement is optional.
          Give such a block a name that says what it holds (for example 'Indicative values') so that a reader
          and a parser reach the same conclusion as the attribute.
          PROFILE NOTE (ISO 33401:2024, §5.3.3):
          - referenceMaterialCertificate: At least one properties block MUST have isCertified="true",
            and all certified property values MUST include expanded measurement uncertainty
            and metrological traceability.
          - productInformationSheet: isCertified MUST NOT be set to "true" on any properties block.
            This prevents informational RM documents from being misrepresented as certified data.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

</xs:schema>
